# Public values. Used by the build script and the browser. The anon key is safe to expose
# (Row Level Security protects the data). NEVER put the service role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SITE_URL=https://okinvibezz.com

# Set these as Supabase Edge Function secrets, not in Netlify and never in git:
#   supabase secrets set NETLIFY_BUILD_HOOK_URL="https://api.netlify.com/build_hooks/..."
#   supabase secrets set ALLOWED_ORIGIN="https://okinvibezz.com"   (optional, locks CORS)
